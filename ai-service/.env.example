# =============================================================================
# ZARI AI SERVICE — environment variables
#
# This service is deployed SEPARATELY from the backend (its own Render service).
# It holds no database and no user data — the Node API is its only caller.
# Copy to .env for local development. Never commit a filled-in .env.
# =============================================================================

ENVIRONMENT=development
PORT=9000
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# SERVICE TOKEN — shared secret with the backend                     [REQUIRED]
# -----------------------------------------------------------------------------
# This is a secret YOU invent. It must be EXACTLY the same value as
# AI_SERVICE_TOKEN in backend/.env — that is the only thing stopping anyone
# else from calling this service and spending your OpenAI credit.
#
# HOW TO GENERATE:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
SERVICE_TOKEN="replace-with-the-same-secret-you-put-in-the-backend"


# -----------------------------------------------------------------------------
# OPENAI                                                             [REQUIRED]
# -----------------------------------------------------------------------------
# HOW TO GET THE KEY:
#   1. Go to https://platform.openai.com and sign up (or sign in).
#      NOTE: this is the API platform, NOT chatgpt.com. A ChatGPT Plus
#      subscription does NOT give you API access — they are billed separately.
#   2. Settings -> Billing -> add a payment method and buy credits.
#      Without credits every request fails with a 429 "insufficient_quota".
#   3. Dashboard -> API keys -> "Create new secret key".
#      Name it "zari-ai-service". Give it write access to Model capabilities.
#   4. Copy the key IMMEDIATELY — it is shown only once. Starts with sk-proj-
#      or sk-.
#   5. Paste it below locally, and set it in Render -> Environment for the
#      deployed service. Never put it in the frontend or commit it.
#   6. Set a monthly spend limit under Settings -> Limits before going live.
#
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Only set this when routing through Azure OpenAI or a gateway/proxy.
# Leave empty for the standard OpenAI API.
OPENAI_BASE_URL=""

# The reasoning model that produces design specs, costing, and budget plans.
# VERIFY the exact id at https://platform.openai.com/docs/models before
# deploying — model names change, and a wrong id fails with a 404.
MODEL_ID="gpt-5"

# How hard the model thinks per call: minimal | low | medium | high
#   high   — best costing and substitution reasoning (default, recommended)
#   medium — noticeably cheaper and faster, slightly blunter trade-offs
#   low    — only for simple calls
REASONING_EFFORT="high"

# Hard ceiling per response. Four full concepts with costing need room —
# do not drop below ~12000 or generations truncate mid-JSON.
MAX_OUTPUT_TOKENS=16000


# -----------------------------------------------------------------------------
# IMAGE GENERATION — GPT Image                                       [optional]
# -----------------------------------------------------------------------------
# IMAGE_PROVIDER=none is the default and is completely fine: the whole product
# works without imagery, the studio canvas just shows its illustrated
# placeholder instead of a rendered garment.
#
# To turn it on set IMAGE_PROVIDER=openai. It uses the SAME OPENAI_API_KEY —
# no extra account needed. Your OpenAI organisation may need identity
# verification before image models are available (Settings -> Organization).
#
# Images come back as base64 and are handed to the backend, which uploads them
# to Supabase Storage. This service never stores anything.
#
# IMAGE_SIZE options: 1024x1024 (square), 1024x1536 (portrait), 1536x1024.
#   Portrait matches the 3:4 the design studio expects.
# IMAGE_QUALITY: low | medium | high | auto. Cost rises steeply with quality;
#   "medium" is a good default for concept exploration.
#
IMAGE_PROVIDER=none
IMAGE_MODEL="gpt-image-2"
IMAGE_SIZE="1024x1536"
IMAGE_QUALITY="medium"
IMAGE_TIMEOUT_SECONDS=120


# -----------------------------------------------------------------------------
# COST TRACKING                                                      [optional]
# -----------------------------------------------------------------------------
# Paise per 1 MILLION tokens. Used only to record spend on the AiJob row so you
# can see what generations cost — these do not change behaviour.
# Update them from https://platform.openai.com/docs/pricing when prices change.
# (Rough default assumes ~$1.25 in / ~$10 out per Mtok at ~₹88/USD.)
INPUT_PAISE_PER_MTOK=110000
OUTPUT_PAISE_PER_MTOK=880000


# -----------------------------------------------------------------------------
# BEHAVIOUR
# -----------------------------------------------------------------------------
# Generating four concepts with full costing is genuinely slow — keep this
# above the backend's AI_SERVICE_TIMEOUT_MS / 1000 or the backend gives up first.
REQUEST_TIMEOUT_SECONDS=180
MAX_CONCEPTS=4
