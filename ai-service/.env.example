# =============================================================================
# ZARI AI SERVICE — environment variables
#
# This service is deployed SEPARATELY from the backend (its own Render service).
# It holds no database and no user data — the Node API is its only caller.
# Copy to .env for local development. Never commit a filled-in .env.
# =============================================================================

ENVIRONMENT=development
PORT=9000
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# SERVICE TOKEN — shared secret with the backend                     [REQUIRED]
# -----------------------------------------------------------------------------
# This is a secret YOU invent. It must be EXACTLY the same value as
# AI_SERVICE_TOKEN in backend/.env — that is the only thing stopping anyone
# else from calling this service and spending your Anthropic credit.
#
# HOW TO GENERATE:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
SERVICE_TOKEN="replace-with-the-same-secret-you-put-in-the-backend"


# -----------------------------------------------------------------------------
# ANTHROPIC — Claude API                                             [REQUIRED]
# -----------------------------------------------------------------------------
# HOW TO GET THE KEY:
#   1. Go to https://console.anthropic.com and sign up (or sign in).
#   2. Settings -> Billing -> add a payment method and buy credits.
#      Without credits every request fails with a 400 about insufficient balance.
#   3. Settings -> API Keys -> "Create Key". Name it "zari-ai-service".
#   4. Copy the key IMMEDIATELY — it is shown only once. Starts with sk-ant-.
#   5. Paste it below locally, and set it in Render -> Environment for the
#      deployed service. Never put it in the frontend or commit it.
#
# COST CONTROL:
#   MODEL_ID   — claude-opus-5 is the default and is what the prompts are tuned
#                for. claude-sonnet-5 is roughly 40% of the cost if you need to
#                trim spend; expect slightly weaker costing reasoning.
#   EFFORT     — how deeply the model reasons per call.
#                low / medium / high / xhigh / max. "high" is the sweet spot for
#                design work; "medium" noticeably cuts token spend and latency.
#   MAX_TOKENS — hard ceiling per response. Four full concepts with costing need
#                room; do not drop below ~12000 or generations truncate.
#
ANTHROPIC_API_KEY="sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MODEL_ID="claude-opus-5"
EFFORT="high"
MAX_TOKENS=16000


# -----------------------------------------------------------------------------
# IMAGE GENERATION                                                   [optional]
# -----------------------------------------------------------------------------
# IMAGE_PROVIDER=none is the default and is completely fine: the whole product
# works without imagery, the studio canvas just shows its illustrated
# placeholder instead of a rendered garment.
#
# REPLICATE (easiest to start, pay-per-second):
#   1. Sign up at https://replicate.com.
#   2. Account settings -> API tokens -> "Create token".
#   3. Add billing under Account -> Billing (no free tier for FLUX models).
#   4. Set IMAGE_PROVIDER=replicate and paste the token below.
#
# FAL (usually faster and cheaper for FLUX):
#   1. Sign up at https://fal.ai.
#   2. Dashboard -> Keys -> "Add key". The key looks like <id>:<secret>.
#   3. Add credits under Billing.
#   4. Set IMAGE_PROVIDER=fal and paste the key below.
#
IMAGE_PROVIDER=none
REPLICATE_API_TOKEN=""
REPLICATE_MODEL="black-forest-labs/flux-1.1-pro"
FAL_API_KEY=""
FAL_MODEL="fal-ai/flux/dev"
IMAGE_TIMEOUT_SECONDS=90


# -----------------------------------------------------------------------------
# BEHAVIOUR
# -----------------------------------------------------------------------------
# Generating four concepts with full costing is genuinely slow — keep this
# above the backend's AI_SERVICE_TIMEOUT_MS / 1000 or the backend gives up first.
REQUEST_TIMEOUT_SECONDS=180
MAX_CONCEPTS=4
