# =============================================================================
# ZARI FRONTEND — build-time environment
#
# Vite only exposes variables prefixed with VITE_. These are baked into the
# bundle at BUILD time, so changing them means rebuilding — and it also means
# nothing secret can go here. Public URLs only.
# =============================================================================

# Where the API lives, with the scheme and NO trailing slash.
#   local:  http://localhost:8080
#   Render: https://zari-api-xxxx.onrender.com
#
# Leave it EMPTY to run in demo mode: no network calls, every screen renders the
# bundled sample data. That is what makes the site presentable before the
# backend is reachable.
VITE_API_URL=""


# -----------------------------------------------------------------------------
# Required by vite.config.ts — it throws if either is missing.
# -----------------------------------------------------------------------------
PORT=22516
BASE_PATH=/
