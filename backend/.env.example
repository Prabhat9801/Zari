# =============================================================================
# ZARI API — environment variables
#
# Copy to .env for local development. On Render, set these under
# Service -> Environment. NEVER commit a filled-in .env.
# Every variable marked REQUIRED must be present or the process refuses to boot.
# =============================================================================

NODE_ENV=development
PORT=8080
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# DATABASE — Supabase Postgres                                       [REQUIRED]
# -----------------------------------------------------------------------------
# HOW TO GET THESE:
#   1. Go to https://supabase.com/dashboard and create (or open) your project.
#   2. Left sidebar -> Project Settings (gear icon) -> Database.
#   3. Scroll to "Connection string" and pick the "URI" tab.
#   4. There are TWO connection strings and you need BOTH:
#
#      DATABASE_URL  = "Transaction pooler"  (host ...pooler.supabase.com, PORT 6543)
#                      Used by the running app. Append ?pgbouncer=true&connection_limit=1
#                      — without pgbouncer=true, Prisma prepared statements break.
#
#      DIRECT_URL    = "Direct connection"   (host db.<ref>.supabase.co,   PORT 5432)
#                      Used ONLY by `prisma migrate`. Migrations cannot run
#                      through the pooler.
#
#   5. Replace [YOUR-PASSWORD] with the database password you set at project
#      creation (Settings -> Database -> "Reset database password" if lost).
#   6. URL-encode special characters in the password (@ becomes %40, # becomes %23).
#
DATABASE_URL="postgresql://postgres.abcdefghijklmnop:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.abcdefghijklmnop.supabase.co:5432/postgres"


# -----------------------------------------------------------------------------
# AUTH — JWT signing secrets                                         [REQUIRED]
# -----------------------------------------------------------------------------
# HOW TO GENERATE (run locally, use a DIFFERENT value for each):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Minimum 32 characters. Rotating these signs out every user, so treat them as
# permanent secrets and store them only in Render's environment settings.
#
JWT_ACCESS_SECRET="replace-with-a-48-byte-random-string-at-least-32-chars"
JWT_REFRESH_SECRET="replace-with-a-DIFFERENT-48-byte-random-string"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30


# -----------------------------------------------------------------------------
# CORS                                                              [REQUIRED]
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins. Use "*" ONLY in local dev.
# In production list the exact deployed frontend URLs — no trailing slash.
#
CORS_ORIGINS="http://localhost:5173,http://localhost:22516"
# Production example:
# CORS_ORIGINS="https://zari.app,https://www.zari.app"


# -----------------------------------------------------------------------------
# AI SERVICE — the separate Python deployment                        [REQUIRED]
# -----------------------------------------------------------------------------
# AI_SERVICE_URL is the base URL of the ai-service you deploy separately on
# Render (no trailing slash). Locally with docker-compose it is http://ai-service:9000.
#
# AI_SERVICE_TOKEN is a shared secret YOU invent — it must be the exact same
# value as SERVICE_TOKEN in ai-service/.env. Generate it with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
AI_SERVICE_URL="http://localhost:9000"
AI_SERVICE_TOKEN="replace-with-a-shared-secret-matching-the-ai-service"
AI_SERVICE_TIMEOUT_MS=120000


# -----------------------------------------------------------------------------
# SUPABASE STORAGE — image uploads                                   [optional]
# -----------------------------------------------------------------------------
# Without these, uploads are disabled but everything else works.
#
# HOW TO GET THESE:
#   1. Supabase dashboard -> Project Settings -> API.
#   2. SUPABASE_URL          = the "Project URL"  (https://<ref>.supabase.co)
#   3. SUPABASE_SERVICE_ROLE_KEY = the "service_role" secret key.
#      WARNING: this key bypasses row-level security. It must ONLY ever live on
#      the server. Never ship it to the browser or commit it.
#   4. Create the bucket: Storage -> New bucket -> name it "zari-media",
#      tick "Public bucket" (design and portfolio images are meant to be public).
#
SUPABASE_URL="https://abcdefghijklmnop.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...."
SUPABASE_STORAGE_BUCKET="zari-media"


# -----------------------------------------------------------------------------
# PAYMENTS — Razorpay                                                [optional]
# -----------------------------------------------------------------------------
# Without these, orders can be created but not paid for.
#
# HOW TO GET THESE:
#   1. Sign up at https://dashboard.razorpay.com (Indian business + PAN needed
#      for live mode; Test mode works immediately with no KYC).
#   2. Account & Settings -> API Keys -> "Generate Test Key".
#      RAZORPAY_KEY_ID     = starts with rzp_test_ (or rzp_live_ in production)
#      RAZORPAY_KEY_SECRET = shown ONCE at generation — save it now.
#   3. Webhook secret: Account & Settings -> Webhooks -> "Add New Webhook".
#      - Webhook URL: https://<your-api-on-render>.onrender.com/api/payments/webhook
#      - Active events: payment.captured, payment.failed, refund.processed
#      - Secret: invent any strong string and paste the SAME value below.
#   4. For designer payouts you additionally need RazorpayX activated
#      (Dashboard -> RazorpayX). Until then payouts stay PENDING for ops.
#
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="a-strong-string-you-also-paste-into-the-razorpay-dashboard"


# -----------------------------------------------------------------------------
# OTP / SMS                                                          [optional]
# -----------------------------------------------------------------------------
# OTP_PROVIDER=console just prints the code to the server log — perfect for
# local development, and the default. Switch to msg91 or twilio in production.
#
# MSG91 (recommended for India — cheapest, and DLT-compliant):
#   1. Sign up at https://msg91.com and complete DLT registration.
#   2. Dashboard -> Authkey -> copy the Auth Key into MSG91_AUTH_KEY.
#   3. Dashboard -> OTP -> create an OTP template, approve it, copy its ID
#      into MSG91_TEMPLATE_ID.
#
# TWILIO (works worldwide, more expensive for Indian numbers):
#   1. Sign up at https://twilio.com/console.
#   2. Account Info panel -> Account SID and Auth Token.
#   3. Phone Numbers -> Buy a number -> use it as TWILIO_FROM_NUMBER (E.164, +1...).
#
OTP_PROVIDER=console
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""


# -----------------------------------------------------------------------------
# BUSINESS RULES
# -----------------------------------------------------------------------------
# ADVANCE_PERCENT      — how much is taken into escrow up front. The remainder
#                        is released to the designer only after QC passes.
# PLATFORM_FEE_PERCENT — Zari's commission, deducted from the payout.
# FIT_WINDOW_DAYS      — how long the customer has to try the garment on.
# GUEST_FREE_GENERATIONS — free designs a visitor gets before signing up.
#
ADVANCE_PERCENT=40
PLATFORM_FEE_PERCENT=10
FIT_WINDOW_DAYS=7
GUEST_FREE_GENERATIONS=1


# -----------------------------------------------------------------------------
# DEPLOY BEHAVIOUR
# -----------------------------------------------------------------------------
# Set to "true" on the FIRST deploy to populate cost rules and demo data.
# Set back to "false" afterwards.
RUN_SEED_ON_START=false
