# Normalise line endings to LF in the repository.
#
# Without this, files committed from Windows carry CRLF, and
# backend/docker-entrypoint.sh then fails inside the Linux container with
# "/bin/sh^M: bad interpreter". Shell scripts and Dockerfiles MUST be LF.
* text=auto eol=lf

*.sh          text eol=lf
Dockerfile    text eol=lf
*.dockerfile  text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.toml        text eol=lf
*.sql         text eol=lf

# Binary assets — never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff  binary
*.woff2 binary
*.ttf   binary

# Generated — collapse in diffs and exclude from language stats.
package-lock.json  linguist-generated=true
pnpm-lock.yaml     linguist-generated=true
backend/prisma/migrations/**  linguist-generated=true
